{
  "name": "gurita-vscode",
  "displayName": "Gurita for VS Code",
  "description": "A mission pane for the Gurita plugin's missions, questions, and recipes.",
  "publisher": "uhappylogic",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uHappyLogic/gurita.git",
    "directory": "gurita-vscode"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:gurita.openMissionPane",
    "onView:gurita.missions"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gurita",
          "title": "Gurita",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "gurita": [
        {
          "id": "gurita.missions",
          "name": "Missions"
        }
      ]
    },
    "commands": [
      {
        "command": "gurita.openMissionPane",
        "title": "Gurita: Open Mission Pane"
      },
      {
        "command": "gurita.refreshMissionPane",
        "title": "Gurita: Refresh Mission Pane"
      }
    ],
    "configuration": {
      "title": "Gurita",
      "properties": {
        "gurita.ownRecipesFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "The path of your own recipe file, read beside the shipped recipes. Left empty, `~/.gurita/recipes.md` is read. A leading `~` stands for your home directory."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile && node scripts/bundle.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/gurita-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
