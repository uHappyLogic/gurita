{
  "name": "gurita-vscode",
  "displayName": "Gurita for VS Code",
  "description": "A side-bar view and mission windows for the Gurita plugin's missions, questions, and recipes.",
  "publisher": "uhappylogic",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uHappyLogic/gurita.git",
    "directory": "gurita-vscode"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:gurita.missions",
    "onWebviewPanel:gurita.mission",
    "onWebviewPanel:gurita.settings"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gurita",
          "title": "Gurita",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "gurita": [
        {
          "id": "gurita.missions",
          "name": "Missions"
        }
      ]
    },
    "commands": [
      {
        "command": "gurita.refreshMissions",
        "title": "Refresh Missions",
        "category": "Gurita",
        "icon": "$(refresh)"
      },
      {
        "command": "gurita.openSettings",
        "title": "Settings",
        "category": "Gurita",
        "icon": "$(gear)"
      },
      {
        "command": "gurita.newMission",
        "title": "New Mission",
        "category": "Gurita"
      },
      {
        "command": "gurita.defineMission",
        "title": "Define Mission",
        "category": "Gurita"
      },
      {
        "command": "gurita.pickStartingVariant",
        "title": "Choose Variant",
        "category": "Gurita",
        "icon": "$(versions)"
      },
      {
        "command": "gurita.openMission",
        "title": "Open Mission",
        "category": "Gurita"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gurita.refreshMissions",
          "when": "view == gurita.missions",
          "group": "navigation@1"
        },
        {
          "command": "gurita.openSettings",
          "when": "view == gurita.missions",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "gurita.openSettings",
          "when": "activeWebviewPanelId == gurita.mission",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gurita.pickStartingVariant",
          "when": "view == gurita.missions && viewItem == gurita.startingRow",
          "group": "inline"
        },
        {
          "command": "gurita.pickStartingVariant",
          "when": "view == gurita.missions && viewItem == gurita.startingRow",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gurita.openSettings",
          "when": "false"
        },
        {
          "command": "gurita.newMission",
          "when": "false"
        },
        {
          "command": "gurita.defineMission",
          "when": "false"
        },
        {
          "command": "gurita.pickStartingVariant",
          "when": "false"
        },
        {
          "command": "gurita.openMission",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Gurita",
      "properties": {
        "gurita.ownRecipesFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "The path of your own recipe file, read beside the shipped recipes. Left empty, `~/.gurita/recipes.md` is read. A leading `~` stands for your home directory."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile && node scripts/bundle.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/gurita-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
